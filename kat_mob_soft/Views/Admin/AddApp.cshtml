@model kat_mob_soft.Domain.ViewModels.AddAppViewModel
@{
    ViewData["Title"] = "Добавить приложение";
    Layout = "_Layout";
}

<div class="container">
    <h1>Добавить новое приложение</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="AddApp" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Name">Название приложения *</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ShortDescription">Краткое описание</label>
            <textarea asp-for="ShortDescription" class="form-control" rows="3"></textarea>
            <span asp-validation-for="ShortDescription" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FullDescription">Полное описание</label>
            <textarea asp-for="FullDescription" class="form-control" rows="5"></textarea>
            <span asp-validation-for="FullDescription" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Price">Цена</label>
                <input asp-for="Price" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]{1,2})?" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Price" class="text-danger"></span>
                <small class="form-text text-muted">Используйте точку как разделитель (например: 8.39)</small>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Currency">Валюта</label>
                <select asp-for="Currency" class="form-control">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="RUB">RUB</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="CategoryName">Категория *</label>
                <select asp-for="CategoryName" class="form-control" required>
                    <option value="">-- Выберите категорию --</option>
                    @foreach (var category in ViewBag.Categories as List<string>)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="DeveloperName">Разработчик *</label>
                <input asp-for="DeveloperName" class="form-control" placeholder="Введите название разработчика" />
                <span asp-validation-for="DeveloperName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label>Иконка приложения</label>
            <input type="file" name="iconFile" accept="image/*" class="form-control-file" />
        </div>

        <div class="form-group">
            <div class="form-check">
                <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                <label asp-for="IsPublished" class="form-check-label">
                    Опубликовать сразу
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Добавить приложение</button>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>

<style>
    .form-group {
        margin-bottom: 20px;
    }

    .form-row {
        display: flex;
        gap: 15px;
    }

    .form-row .form-group {
        flex: 1;
    }

    label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    .form-control-file {
        padding: 8px 0;
    }

    textarea.form-control {
        resize: vertical;
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-check-input {
        margin: 0;
    }

    .form-actions {
        margin-top: 30px;
        display: flex;
        gap: 15px;
    }

    .btn {
        padding: 12px 24px;
        text-decoration: none;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background-color: #545b62;
    }

    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .text-danger {
        color: #dc3545;
        font-size: 14px;
    }
</style>

