@model List<kat_mob_soft.Domain.ViewModels.AppViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Каталог приложений";
}

<div class="container-apps">
    <div class="link-page">
        <a href="/Home/SiteInformation">Главная</a>
        > Каталог приложений
    </div>

    <div class="grid-container">
        @if (Model != null && Model.Count != 0)
        {
            @foreach (var item in Model)
            {
                <div class="card-app">
                    <div class="card-image-wrapper">
                        <img src="@item.PathImg" alt="@item.Name" class="card-image" />
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">@item.Name</h3>
                        <div class="card-category-price">
                            <span class="card-category">@item.CategoryName</span>
                            @if (item.Price > 0)
                            {
                                <span class="card-price">@item.Price.ToString("F2") @item.Currency</span>
                            }
                        </div>
                        <div class="card-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(item.AverageRating))
                                {
                                    <span class="star filled">★</span>
                                }
                                else
                                {
                                    <span class="star">★</span>
                                }
                            }
                            <span class="rating-value">@item.AverageRating.ToString("F1")</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="no-apps-message">Приложения не найдены</p>
        }
    </div>
</div>

